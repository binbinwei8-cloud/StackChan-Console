# StackChan Local desktop daemon
STACKCHAN_LOCAL_HOST=0.0.0.0
STACKCHAN_LOCAL_PORT=8787

# WebUI dashboard
STACKCHAN_PREVIEW_ENABLED=1
STACKCHAN_PREVIEW_HOST=127.0.0.1
STACKCHAN_PREVIEW_PORT=8788

# Change this before using real hardware.
STACKCHAN_PAIRING_TOKEN=dev-local-token
STACKCHAN_ADVERTISE_MDNS=1

# Codex companion state mirror
STACKCHAN_CODEX_STATUS=1
# STACKCHAN_CODEX_SESSIONS_ROOT=/path/to/.codex/sessions
# Set this to one rollout JSONL file to read each final reply in that Codex chat.
# STACKCHAN_CODEX_SESSION_FILE=/path/to/.codex/sessions/YYYY/MM/DD/rollout-....jsonl

# Camera-based face tracking
STACKCHAN_FACE_TRACKING=0
STACKCHAN_FACE_TRACKING_PYTHON=python3
STACKCHAN_FACE_TRACKING_CAMERA_PRESET=fast
STACKCHAN_FACE_TRACKING_MIRROR_X=false
STACKCHAN_FACE_TRACKING_SPEED=300
STACKCHAN_FACE_TRACKING_DEADBAND=0.08
STACKCHAN_FACE_TRACKING_YAW_KP=36
STACKCHAN_FACE_TRACKING_YAW_KI=0
STACKCHAN_FACE_TRACKING_YAW_KD=1.2
STACKCHAN_FACE_TRACKING_PITCH_KP=8
STACKCHAN_FACE_TRACKING_PITCH_KI=0
STACKCHAN_FACE_TRACKING_PITCH_KD=0.15
STACKCHAN_FACE_TRACKING_INTEGRAL_LIMIT=0.35
STACKCHAN_FACE_TRACKING_OUTPUT_LIMIT_DEG=4
STACKCHAN_FACE_TRACKING_YUNET_MODEL=desktop/models/face_detection_yunet_2023mar.onnx
STACKCHAN_FACE_TRACKING_YUNET_SCORE_THRESHOLD=0.85
STACKCHAN_FACE_TRACKING_YUNET_NMS_THRESHOLD=0.3
STACKCHAN_FACE_TRACKING_YUNET_TOP_K=500
STACKCHAN_FACE_TRACKING_TRACE_LOG=logs/face-tracking.ndjson

# Optional completion or selected-chat reply TTS. Disabled by default.
STACKCHAN_VOLCENGINE_TTS_ENABLED=0
VOLCENGINE_TTS_API_KEY=
## Qwen Omni Realtime (set both values before enabling voice chat in WebUI)
DASHSCOPE_API_KEY=
STACKCHAN_QWEN_WORKSPACE_ID=
STACKCHAN_QWEN_REGION=cn-beijing
STACKCHAN_QWEN_MODEL=qwen3.8-omni-flash-realtime
STACKCHAN_QWEN_VOICE=longanlingxin
# WebUI model/search choices are saved locally here (no API key is stored in this file).
STACKCHAN_QWEN_SETTINGS_FILE=logs/voice-chat-settings.json
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE_ID=zh_male_liangsangmengzai_uranus_bigtts
VOLCENGINE_TTS_SAMPLE_RATE=16000
STACKCHAN_CODEX_COMPLETION_TTS_TEXT=Codex task finished.
STACKCHAN_CODEX_COMPLETION_TTS_VOLUME=80

STACKCHAN_LOG_LEVEL=info
